# Copy to .env and fill in real values before deploying.
# Never commit .env with real secrets.

POSTGRES_PASSWORD=changeme-use-a-real-random-password

# Comma-separated list of real domains allowed to call this API.
# Do NOT use * in any deployment reachable outside your own machine.
ALLOWED_ORIGINS=https://yourdomain.com

# Real shared secret required in the X-API-Key header on every request
# once deployed publicly. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-real-random-key

# Only needs changing if Ollama runs somewhere other than the Docker host
OLLAMA_URL=http://host.docker.internal:11434/api/chat
LOCAL_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
